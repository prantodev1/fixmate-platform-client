# FixMate Platform Client - environment variables
#
# Local setup: copy this file to .env and fill in the values.
# Vercel: add the same names under Project Settings > Environment Variables
# for the Production (and Preview) environment, then redeploy.
#
# All values are NEXT_PUBLIC_*, so they are inlined at build time.
# Changing them in Vercel requires a new deployment.
#
# The API URL is also used by the Next.js `/api/*` rewrite proxy, so browser
# requests stay same-origin and are not blocked by CORS or mixed content.
# A comma separated list is accepted; unreachable/localhost entries are ignored
# on deployed HTTPS builds. Do not add a trailing slash.

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google OAuth client ID used by the sign-in and sign-up pages.
# Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ImgBB API key for avatar and service image uploads.
# Leave empty to store a compressed inline image instead.
NEXT_PUBLIC_IMGBB_API_KEY=
